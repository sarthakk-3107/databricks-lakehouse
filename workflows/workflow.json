{
  "name": "fin-lakehouse-fraud",
  "description": "Bronze -> silver -> gold lakehouse plus fraud model training, evaluation, segmentation and monitoring.",
  "max_concurrent_runs": 1,
  "timeout_seconds": 7200,
  "git_source": {
    "git_url": "https://github.com/sarthakk-3107/databricks-lakehouse",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "parameters": [
    { "name": "catalog", "default": "workspace" }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 6 * * ?",
    "timezone_id": "America/New_York",
    "pause_status": "PAUSED"
  },
  "tasks": [
    {
      "task_key": "setup_catalog",
      "notebook_task": { "notebook_path": "notebooks/00_setup_catalog", "source": "GIT" }
    },
    {
      "task_key": "generate_data",
      "depends_on": [{ "task_key": "setup_catalog" }],
      "notebook_task": { "notebook_path": "data/generate_transactions", "source": "GIT" }
    },
    {
      "task_key": "bronze_ingest",
      "depends_on": [{ "task_key": "generate_data" }],
      "notebook_task": { "notebook_path": "notebooks/01_bronze_ingest", "source": "GIT" },
      "max_retries": 1,
      "min_retry_interval_millis": 60000
    },
    {
      "task_key": "silver_clean",
      "depends_on": [{ "task_key": "bronze_ingest" }],
      "notebook_task": { "notebook_path": "notebooks/02_silver_clean", "source": "GIT" }
    },
    {
      "task_key": "gold_aggregations",
      "depends_on": [{ "task_key": "silver_clean" }],
      "notebook_task": { "notebook_path": "notebooks/03_gold_aggregations", "source": "GIT" }
    },
    {
      "task_key": "feature_engineering",
      "depends_on": [{ "task_key": "silver_clean" }],
      "notebook_task": { "notebook_path": "notebooks/05_feature_engineering", "source": "GIT" }
    },
    {
      "task_key": "train_fraud_model",
      "depends_on": [{ "task_key": "feature_engineering" }],
      "notebook_task": { "notebook_path": "notebooks/06_train_fraud_model", "source": "GIT" }
    },
    {
      "task_key": "evaluate_and_threshold",
      "depends_on": [{ "task_key": "train_fraud_model" }],
      "notebook_task": {
        "notebook_path": "notebooks/07_evaluate_and_threshold",
        "source": "GIT",
        "base_parameters": { "false_positive_cost": "10" }
      }
    },
    {
      "task_key": "customer_segmentation",
      "depends_on": [{ "task_key": "feature_engineering" }],
      "notebook_task": { "notebook_path": "notebooks/08_customer_segmentation", "source": "GIT" }
    },
    {
      "task_key": "monitoring",
      "depends_on": [
        { "task_key": "gold_aggregations" },
        { "task_key": "evaluate_and_threshold" },
        { "task_key": "customer_segmentation" }
      ],
      "notebook_task": { "notebook_path": "notebooks/04_monitoring_dashboard", "source": "GIT" }
    }
  ]
}
